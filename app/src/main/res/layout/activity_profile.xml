<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="@color/primary"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
             android:layout_height="40dp"
             android:layout_width="40dp"
             app:cardCornerRadius="20dp"
             app:cardElevation="0dp"
             app:strokeWidth="0dp"
             app:cardBackgroundColor="#33FFFFFF"
             android:clickable="true"
             android:focusable="true"
             android:id="@+id/btnBack">

            <ImageView
                 android:layout_height="20dp"
                 android:layout_width="20dp"
                 android:layout_gravity="center"
                 android:src="@drawable/ic_chevron_right"
                 android:rotation="180"
                 app:tint="#FFFFFF" />

        </com.google.android.material.card.MaterialCardView>

        <FrameLayout
            android:layout_width="114dp"
            android:layout_height="114dp"
            android:layout_centerInParent="true">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProfileAvatar"
                android:layout_width="106dp"
                android:layout_height="106dp"
                android:layout_gravity="center"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="53dp"
                app:cardElevation="2dp"
                app:strokeColor="#FFFFFF"
                app:strokeWidth="3.5dp">

                <ImageView
                    android:id="@+id/ivProfileAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/surface_card"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_person"
                    app:tint="@color/primary"
                    android:padding="20dp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Camera / Edit Photo Badge -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEditPhotoBadge"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="bottom|end"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="17dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/primary"
                app:strokeWidth="1.5dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/primary" />
            </com.google.android.material.card.MaterialCardView>

        </FrameLayout>
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="-30dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvProfileName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Employee Name"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvProfileId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="ID: 0000000000"
                        android:textColor="@color/text_secondary" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvProfileRole"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_green"
                            android:textColor="@color/badge_green_icon"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp"
                            android:textSize="12sp"
                            android:text="Role: USER"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvProfileStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_badge_blue"
                            android:textColor="@color/badge_blue_icon"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp"
                            android:textSize="12sp"
                            android:text="Approved"
                            android:textStyle="bold" />

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView style="@style/ProfileLabel" android:text="Mobile Number" />
                    <TextView android:id="@+id/tvProfileMobile" style="@style/ProfileValue" android:text="01915519710" />
                    <View style="@style/Divider" />

                    <TextView style="@style/ProfileLabel" android:text="Official Number" />
                    <TextView android:id="@+id/tvProfileOfficialNumber" style="@style/ProfileValue" android:text="N/A" />
                    <View style="@style/Divider" />

                    <TextView style="@style/ProfileLabel" android:text="Branch" />
                    <TextView android:id="@+id/tvProfileBranch" style="@style/ProfileValue" android:text="Khalishpur" />
                    <View style="@style/Divider" />

                    <TextView style="@style/ProfileLabel" android:text="Zone" />
                    <TextView android:id="@+id/tvProfileZone" style="@style/ProfileValue" android:text="Sylhet" />
                    <View style="@style/Divider" />

                    <TextView style="@style/ProfileLabel" android:text="Sales Manager" />
                    <TextView android:id="@+id/tvProfileManager" style="@style/ProfileValue" android:text="Asma Akter" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Target & Achievement Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProfileTarget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_badge_mint">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_target"
                                app:tint="@color/badge_mint_icon" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="Performance Target"
                            android:textSize="16sp"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvProfileAchievementBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_green"
                            android:textColor="@color/badge_green_icon"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="0.0%" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/ProfileLabel"
                                android:text="Monthly Target" />

                            <TextView
                                android:id="@+id/tvProfileTargetCount"
                                style="@style/ProfileValue"
                                android:text="0 Cards"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/ProfileLabel"
                                android:text="Achieved Cards" />

                            <TextView
                                android:id="@+id/tvProfileAchievedCount"
                                style="@style/ProfileValue"
                                android:textColor="@color/badge_green_icon"
                                android:text="0 Cards"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressProfileTarget"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="8dp"
                        app:trackColor="#E0E0E0"
                        app:indicatorColor="@color/primary"
                        android:progress="0"
                        android:max="100" />

                    <!-- Admin action: Set / Edit Target button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnProfileSetTarget"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="14dp"
                        app:cornerRadius="12dp"
                        android:text="🎯 Set / Update Target (Admin)"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditProfile"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                app:backgroundTint="@color/primary"
                android:text="Edit Profile"
                android:textColor="#FFFFFF"
                app:icon="@android:drawable/ic_menu_edit"
                app:iconTint="#FFFFFF"
                app:elevation="0dp"
                app:cornerRadius="14dp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                app:backgroundTint="@color/badge_red_bg"
                android:text="Logout Account"
                android:textColor="@color/badge_red_icon"
                app:elevation="0dp"
                app:cornerRadius="14dp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>

