<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="wrap_content"
     android:layout_width="match_parent"
     android:layout_marginVertical="6dp"
     android:layout_marginHorizontal="16dp"
     app:cardElevation="0dp"
     app:strokeColor="@color/card_stroke"
     app:strokeWidth="1dp"
     app:cardBackgroundColor="@color/surface_card"
     app:cardCornerRadius="18dp">

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:padding="16dp"
         android:orientation="vertical">

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:textSize="18sp"
             android:textColor="@color/text_primary"
             android:id="@+id/tvUserName"
             android:text="Name"
             android:textStyle="bold" />

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:textColor="@color/text_secondary"
             android:layout_marginTop="4dp"
             android:id="@+id/tvUserId"
             android:text="ID: 123456789012" />

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:textColor="@color/text_muted"
             android:layout_marginTop="2dp"
             android:id="@+id/tvUserLocation"
             android:text="Branch: Mirpur | Zone: Dhaka" />

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:weightSum="2"
             android:orientation="horizontal"
             android:layout_marginTop="14dp">

            <com.google.android.material.button.MaterialButton
                 android:layout_height="48dp"
                 android:layout_width="0dp"
                 android:layout_marginEnd="6dp"
                 app:cornerRadius="12dp"
                 app:elevation="0dp"
                 app:backgroundTint="@color/badge_green_bg"
                 android:textColor="@color/badge_green_icon"
                 android:layout_weight="1"
                 android:id="@+id/btnPositive"
                 android:text="APPROVE"
                 android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                 android:layout_height="48dp"
                 android:layout_width="0dp"
                 app:cornerRadius="12dp"
                 app:elevation="0dp"
                 app:backgroundTint="@color/badge_red_bg"
                 android:textColor="@color/badge_red_icon"
                 android:layout_marginStart="6dp"
                 android:layout_weight="1"
                 android:id="@+id/btnNegative"
                 android:text="REJECT"
                 android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
