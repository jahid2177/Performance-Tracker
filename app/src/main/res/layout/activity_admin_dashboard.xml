<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:background="@color/background"
     android:orientation="vertical">

    <!-- Top App Bar matching screenshot aesthetic -->
    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:background="@color/background"
         android:gravity="center_vertical"
         android:paddingHorizontal="20dp"
         android:paddingTop="20dp"
         android:paddingBottom="12dp">

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="0dp"
             android:textSize="24sp"
             android:textColor="@color/text_primary"
             android:layout_weight="1"
             android:id="@+id/tvHeaderTitle"
             android:text="Control Panel"
             android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
             android:layout_height="40dp"
             android:layout_width="40dp"
             app:cardCornerRadius="20dp"
             app:cardElevation="0dp"
             app:strokeWidth="1dp"
             app:strokeColor="@color/card_stroke"
             app:cardBackgroundColor="@color/surface"
             android:clickable="true"
             android:focusable="true">

            <ImageView
                 android:layout_height="20dp"
                 android:layout_width="20dp"
                 android:layout_gravity="center"
                 android:src="@drawable/ic_logout"
                 app:tint="@color/text_primary"
                 android:id="@+id/btnTopAction" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <ScrollView
         android:layout_height="match_parent"
         android:layout_width="match_parent"
         android:fillViewport="true">

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:paddingHorizontal="16dp"
             android:paddingBottom="24dp"
             android:orientation="vertical">

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:orientation="vertical"
                 android:id="@+id/optionsLayout">

                <!-- Main Actions Section -->
                <TextView
                     style="@style/SectionHeader"
                     android:text="MAIN ACTIONS" />

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:layout_marginBottom="10dp"
                     android:weightSum="2"
                     android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                         android:layout_height="52dp"
                         android:layout_width="0dp"
                         android:layout_marginEnd="6dp"
                         app:backgroundTint="@color/badge_green_bg"
                         app:cornerRadius="14dp"
                         app:elevation="0dp"
                         android:textColor="@color/badge_green_icon"
                         android:layout_weight="1"
                         android:id="@+id/btnFilterMonthWise"
                         android:text="Month"
                         android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                         android:layout_height="52dp"
                         android:layout_width="0dp"
                         app:backgroundTint="@color/badge_blue_bg"
                         app:cornerRadius="14dp"
                         app:elevation="0dp"
                         android:textColor="@color/badge_blue_icon"
                         android:layout_marginStart="6dp"
                         android:layout_weight="1"
                         android:id="@+id/btnFilterIndividual"
                         android:text="Individual"
                         android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:layout_marginBottom="16dp"
                     android:weightSum="2"
                     android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                         android:layout_height="52dp"
                         android:layout_width="0dp"
                         android:layout_marginEnd="6dp"
                         app:backgroundTint="@color/badge_red_bg"
                         app:cornerRadius="14dp"
                         app:elevation="0dp"
                         android:textColor="@color/badge_red_icon"
                         android:layout_weight="1"
                         android:id="@+id/btnWhoNotSubmitted"
                         android:text="Not Submitted"
                         android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                         android:layout_height="52dp"
                         android:layout_width="0dp"
                         app:backgroundTint="@color/badge_mint_bg"
                         app:cornerRadius="14dp"
                         app:elevation="0dp"
                         android:textColor="@color/badge_mint_icon"
                         android:layout_marginStart="6dp"
                         android:layout_weight="1"
                         android:id="@+id/btnDownloadExcel"
                         android:text="Export Report"
                         android:textStyle="bold" />

                </LinearLayout>

                <!-- Filters & Ranking Section -->
                <TextView
                     style="@style/SectionHeader"
                     android:text="FILTERS &amp; RANKING" />

                <HorizontalScrollView
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:layout_marginBottom="16dp"
                     android:scrollbars="none">

                    <LinearLayout
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                             android:layout_height="46dp"
                             android:layout_width="wrap_content"
                             android:layout_marginEnd="8dp"
                             app:backgroundTint="@color/badge_amber_bg"
                             app:cornerRadius="12dp"
                             app:elevation="0dp"
                             android:textColor="@color/badge_amber_icon"
                             android:id="@+id/btnFilterRanking"
                             android:text="Ranking"
                             android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                             android:layout_height="46dp"
                             android:layout_width="wrap_content"
                             android:layout_marginEnd="8dp"
                             app:backgroundTint="@color/badge_blue_bg"
                             app:cornerRadius="12dp"
                             app:elevation="0dp"
                             android:textColor="@color/badge_blue_icon"
                             android:id="@+id/btnOfficerList"
                             android:text="Officer List"
                             android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                             android:layout_height="46dp"
                             android:layout_width="wrap_content"
                             android:layout_marginEnd="8dp"
                             app:backgroundTint="@color/badge_green_bg"
                             app:cornerRadius="12dp"
                             app:elevation="0dp"
                             android:textColor="@color/badge_green_icon"
                             android:id="@+id/btnApproval"
                             android:text="Approval List"
                             android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                             android:layout_height="46dp"
                             android:layout_width="wrap_content"
                             android:layout_marginEnd="8dp"
                             app:backgroundTint="@color/badge_grey_bg"
                             app:cornerRadius="12dp"
                             app:elevation="0dp"
                             android:textColor="@color/badge_grey_icon"
                             android:id="@+id/btnFilterZone"
                             android:text="Zone"
                             android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                             android:layout_height="46dp"
                             android:layout_width="wrap_content"
                             android:layout_marginEnd="4dp"
                             app:backgroundTint="@color/badge_mint_bg"
                             app:cornerRadius="12dp"
                             app:elevation="0dp"
                             android:textColor="@color/badge_mint_icon"
                             android:id="@+id/btnFilterTeam"
                             android:text="Manager Team"
                             android:textStyle="bold" />

                    </LinearLayout>

                </HorizontalScrollView>

            </LinearLayout>

            <View
                 android:layout_height="1dp"
                 android:layout_width="match_parent"
                 android:layout_marginBottom="16dp"
                 android:background="@color/divider_color" />

            <RelativeLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:layout_marginBottom="12dp">

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:layout_centerVertical="true"
                     android:textSize="17sp"
                     android:textColor="@color/text_primary"
                     android:id="@+id/tvFilterStatus"
                     android:text="Dashboard: 0 cards"
                     android:textStyle="bold" />

                <ImageView
                     android:layout_height="28dp"
                     android:layout_width="28dp"
                     android:src="@android:drawable/ic_popup_sync"
                     android:layout_centerVertical="true"
                     app:tint="@color/primary"
                     android:layout_alignParentEnd="true"
                     android:id="@+id/btnRefresh" />

            </RelativeLayout>

            <ProgressBar
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:visibility="gone"
                 android:id="@+id/progressBar"
                 android:layout_gravity="center" />

            <androidx.recyclerview.widget.RecyclerView
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:nestedScrollingEnabled="false"
                 android:id="@+id/recyclerAdminReport" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
