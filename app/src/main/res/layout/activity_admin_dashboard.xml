<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:background="@color/background"
     android:orientation="vertical">

    <!-- Top Executive Header Bar -->
    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:background="@color/surface"
         android:gravity="center_vertical"
         android:paddingHorizontal="20dp"
         android:paddingTop="16dp"
         android:paddingBottom="14dp"
         android:elevation="1dp">

        <LinearLayout
             android:layout_width="0dp"
             android:layout_height="wrap_content"
             android:layout_weight="1"
             android:orientation="vertical">

            <TextView
                 android:id="@+id/tvHeaderTitle"
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textSize="22sp"
                 android:textColor="@color/text_primary"
                 android:text="Control Panel (ADMIN)"
                 android:textStyle="bold" />

            <TextView
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:text="Performance &amp; Analytics Dashboard"
                 android:textColor="@color/text_secondary"
                 android:textSize="12sp"
                 android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Firestore & Room Sync Status Button -->
        <com.google.android.material.card.MaterialCardView
             android:id="@+id/btnAdminSyncStatus"
             android:layout_height="42dp"
             android:layout_width="42dp"
             android:layout_marginEnd="10dp"
             app:cardCornerRadius="21dp"
             app:cardElevation="0dp"
             app:strokeWidth="1dp"
             app:strokeColor="@color/card_stroke"
             app:cardBackgroundColor="@color/background"
             android:clickable="true"
             android:focusable="true">

            <ImageView
                 android:id="@+id/ivAdminSyncIcon"
                 android:layout_height="22dp"
                 android:layout_width="22dp"
                 android:layout_gravity="center"
                 android:src="@drawable/ic_cloud_done"
                 app:tint="#15803D" />

        </com.google.android.material.card.MaterialCardView>

        <FrameLayout
             android:layout_width="wrap_content"
             android:layout_height="wrap_content">

            <com.google.android.material.card.MaterialCardView
                 android:id="@+id/btnAdminSettings"
                 android:layout_height="42dp"
                 android:layout_width="42dp"
                 app:cardCornerRadius="21dp"
                 app:cardElevation="0dp"
                 app:strokeWidth="1dp"
                 app:strokeColor="@color/card_stroke"
                 app:cardBackgroundColor="@color/background"
                 android:clickable="true"
                 android:focusable="true">

                <ImageView
                     android:id="@+id/ivAdminSettingsIcon"
                     android:layout_height="22dp"
                     android:layout_width="22dp"
                     android:layout_gravity="center"
                     android:src="@drawable/ic_settings"
                     app:tint="@color/text_primary" />

            </com.google.android.material.card.MaterialCardView>

            <View
                 android:id="@+id/viewAdminSettingsRedDot"
                 android:layout_width="12dp"
                 android:layout_height="12dp"
                 android:layout_gravity="top|end"
                 android:background="@drawable/bg_badge_red_dot"
                 android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

    <ScrollView
         android:layout_height="match_parent"
         android:layout_width="match_parent"
         android:fillViewport="true">

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:paddingHorizontal="16dp"
             android:paddingTop="12dp"
             android:paddingBottom="24dp"
             android:orientation="vertical">

            <!-- MAIN ACTIONS SECTION -->
            <LinearLayout
                 android:id="@+id/optionsLayout"
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:orientation="vertical">

                <TextView
                     style="@style/SectionHeader"
                     android:text="MAIN ACTIONS"
                     android:layout_marginBottom="8dp" />

                <!-- Action Grid Row 1: Month View & Individual View -->
                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:layout_marginBottom="10dp"
                     android:weightSum="2"
                     android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                         android:id="@+id/btnFilterMonthWise"
                         android:layout_height="52dp"
                         android:layout_width="0dp"
                         android:layout_weight="1"
                         android:layout_marginEnd="6dp"
                         app:backgroundTint="@color/badge_green_bg"
                         app:cornerRadius="14dp"
                         app:elevation="0dp"
                         android:textColor="@color/badge_green_icon"
                         android:text="Month View"
                         android:textStyle="bold"
                         app:icon="@drawable/ic_report"
                         app:iconTint="@color/badge_green_icon"
                         app:iconPadding="8dp" />

                    <com.google.android.material.button.MaterialButton
                         android:id="@+id/btnFilterIndividual"
                         android:layout_height="52dp"
                         android:layout_width="0dp"
                         android:layout_weight="1"
                         android:layout_marginStart="6dp"
                         app:backgroundTint="@color/badge_blue_bg"
                         app:cornerRadius="14dp"
                         app:elevation="0dp"
                         android:textColor="@color/badge_blue_icon"
                         android:text="Individual View"
                         android:textStyle="bold"
                         app:icon="@drawable/ic_person"
                         app:iconTint="@color/badge_blue_icon"
                         app:iconPadding="8dp" />

                </LinearLayout>

                <!-- Action Grid Row 2: Monthly PDF & Export Excel -->
                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:layout_marginBottom="10dp"
                     android:weightSum="2"
                     android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                         android:id="@+id/btnMonthlyPdf"
                         android:layout_height="52dp"
                         android:layout_width="0dp"
                         android:layout_weight="1"
                         android:layout_marginEnd="6dp"
                         app:backgroundTint="@color/badge_mint_bg"
                         app:cornerRadius="14dp"
                         app:elevation="0dp"
                         android:textColor="@color/badge_mint_icon"
                         android:text="Monthly PDF"
                         android:textStyle="bold"
                         app:icon="@drawable/ic_file_pdf"
                         app:iconTint="@color/badge_mint_icon"
                         app:iconPadding="8dp" />

                    <com.google.android.material.button.MaterialButton
                         android:id="@+id/btnExportCsv"
                         android:layout_height="52dp"
                         android:layout_width="0dp"
                         android:layout_weight="1"
                         android:layout_marginStart="6dp"
                         app:backgroundTint="@color/badge_blue_bg"
                         app:cornerRadius="14dp"
                         app:elevation="0dp"
                         android:textColor="@color/badge_blue_icon"
                         android:text="Export Excel"
                         android:textStyle="bold"
                         app:icon="@drawable/ic_share"
                         app:iconTint="@color/badge_blue_icon"
                         app:iconPadding="8dp" />

                </LinearLayout>

                <!-- Action Grid Row 3: Not Submitted & Trend Chart Toggle -->
                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:layout_marginBottom="12dp"
                     android:weightSum="2"
                     android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                         android:id="@+id/btnWhoNotSubmitted"
                         android:layout_height="52dp"
                         android:layout_width="0dp"
                         android:layout_weight="1"
                         android:layout_marginEnd="6dp"
                         app:backgroundTint="@color/badge_red_bg"
                         app:cornerRadius="14dp"
                         app:elevation="0dp"
                         android:textColor="@color/badge_red_icon"
                         android:text="Not Submitted"
                         android:textStyle="bold"
                         app:icon="@drawable/ic_clear"
                         app:iconTint="@color/badge_red_icon"
                         app:iconPadding="8dp" />

                    <com.google.android.material.button.MaterialButton
                         android:id="@+id/btnToggleTrendChart"
                         android:layout_height="52dp"
                         android:layout_width="0dp"
                         android:layout_weight="1"
                         android:layout_marginStart="6dp"
                         app:backgroundTint="@color/badge_amber_bg"
                         app:cornerRadius="14dp"
                         app:elevation="0dp"
                         android:textColor="@color/badge_amber_icon"
                         android:text="Trend Chart"
                         android:textStyle="bold"
                         app:icon="@drawable/ic_chart_line"
                         app:iconTint="@color/badge_amber_icon"
                         app:iconPadding="8dp" />

                </LinearLayout>

                <!-- Hidden Legacy Button for Backward Compatibility -->
                <Button
                     android:id="@+id/btnDownloadExcel"
                     android:layout_width="0dp"
                     android:layout_height="0dp"
                     android:visibility="gone" />

                <!-- Performance Trend Line Chart Card (MPAndroidChart) -->
                <com.google.android.material.card.MaterialCardView
                     android:id="@+id/cardTrendChart"
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:layout_marginBottom="18dp"
                     app:cardCornerRadius="18dp"
                     app:cardElevation="0dp"
                     app:strokeWidth="1dp"
                     app:strokeColor="@color/card_stroke"
                     app:cardBackgroundColor="@color/surface">

                    <LinearLayout
                         android:layout_height="wrap_content"
                         android:layout_width="match_parent"
                         android:orientation="vertical"
                         android:padding="16dp">

                        <LinearLayout
                             android:layout_height="wrap_content"
                             android:layout_width="match_parent"
                             android:gravity="center_vertical"
                             android:orientation="horizontal">

                            <ImageView
                                 android:layout_height="22dp"
                                 android:layout_width="22dp"
                                 android:src="@drawable/ic_chart_line"
                                 app:tint="@color/primary" />

                            <TextView
                                 android:id="@+id/tvTrendChartTitle"
                                 android:layout_height="wrap_content"
                                 android:layout_width="0dp"
                                 android:layout_weight="1"
                                 android:layout_marginStart="10dp"
                                 android:textSize="16sp"
                                 android:textColor="@color/text_primary"
                                 android:textStyle="bold"
                                 android:text="Performance Trend Analytics" />

                            <TextView
                                 android:id="@+id/tvTrendSelectedOfficer"
                                 android:layout_height="wrap_content"
                                 android:layout_width="wrap_content"
                                 android:textSize="12sp"
                                 android:textColor="@color/text_secondary"
                                 android:text="All Officers" />

                        </LinearLayout>

                        <!-- Officer Selector Dropdown -->
                        <LinearLayout
                             android:layout_height="wrap_content"
                             android:layout_width="match_parent"
                             android:layout_marginTop="12dp"
                             android:gravity="center_vertical"
                             android:orientation="horizontal">

                            <TextView
                                 android:layout_height="wrap_content"
                                 android:layout_width="wrap_content"
                                 android:textSize="13sp"
                                 android:textColor="@color/text_secondary"
                                 android:text="Select Officer:"
                                 android:textStyle="bold" />

                            <Spinner
                                 android:id="@+id/spinnerChartEmployee"
                                 android:layout_height="42dp"
                                 android:layout_width="match_parent"
                                 android:layout_marginStart="10dp"
                                 android:backgroundTint="@color/primary" />

                        </LinearLayout>

                        <!-- Summary Trend Metrics -->
                        <LinearLayout
                             android:layout_height="wrap_content"
                             android:layout_width="match_parent"
                             android:layout_marginTop="12dp"
                             android:weightSum="3"
                             android:orientation="horizontal">

                            <LinearLayout
                                 android:layout_height="wrap_content"
                                 android:layout_width="0dp"
                                 android:layout_weight="1"
                                 android:layout_marginEnd="4dp"
                                 android:background="@drawable/bg_badge_blue"
                                 android:padding="8dp"
                                 android:orientation="vertical">

                                <TextView
                                     android:id="@+id/tvTrendTotalCards"
                                     android:layout_height="wrap_content"
                                     android:layout_width="wrap_content"
                                     android:textSize="12sp"
                                     android:textColor="@color/badge_blue_icon"
                                     android:textStyle="bold"
                                     android:text="Total: 0" />

                                <TextView
                                     android:layout_height="wrap_content"
                                     android:layout_width="wrap_content"
                                     android:textSize="10sp"
                                     android:textColor="@color/badge_blue_icon"
                                     android:text="Annual Cards" />

                            </LinearLayout>

                            <LinearLayout
                                 android:layout_height="wrap_content"
                                 android:layout_width="0dp"
                                 android:layout_weight="1"
                                 android:layout_marginHorizontal="2dp"
                                 android:background="@drawable/bg_badge_green"
                                 android:padding="8dp"
                                 android:orientation="vertical">

                                <TextView
                                     android:id="@+id/tvTrendPeakMonth"
                                     android:layout_height="wrap_content"
                                     android:layout_width="wrap_content"
                                     android:textSize="12sp"
                                     android:textColor="@color/badge_green_icon"
                                     android:textStyle="bold"
                                     android:text="Peak: -" />

                                <TextView
                                     android:layout_height="wrap_content"
                                     android:layout_width="wrap_content"
                                     android:textSize="10sp"
                                     android:textColor="@color/badge_green_icon"
                                     android:text="Best Month" />

                            </LinearLayout>

                            <LinearLayout
                                 android:layout_height="wrap_content"
                                 android:layout_width="0dp"
                                 android:layout_weight="1"
                                 android:layout_marginStart="4dp"
                                 android:background="@drawable/bg_badge_mint"
                                 android:padding="8dp"
                                 android:orientation="vertical">

                                <TextView
                                     android:id="@+id/tvTrendAvgMonthly"
                                     android:layout_height="wrap_content"
                                     android:layout_width="wrap_content"
                                     android:textSize="12sp"
                                     android:textColor="@color/badge_mint_icon"
                                     android:textStyle="bold"
                                     android:text="Avg: 0.0" />

                                <TextView
                                     android:layout_height="wrap_content"
                                     android:layout_width="wrap_content"
                                     android:textSize="10sp"
                                     android:textColor="@color/badge_mint_icon"
                                     android:text="Avg / Month" />

                            </LinearLayout>

                        </LinearLayout>

                        <!-- MPAndroidChart LineChart -->
                        <com.github.mikephil.charting.charts.LineChart
                             android:id="@+id/trendLineChart"
                             android:layout_height="220dp"
                             android:layout_width="match_parent"
                             android:layout_marginTop="12dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- FILTERS & RANKING NAVIGATION -->
                <TextView
                     style="@style/SectionHeader"
                     android:text="QUICK FILTERS &amp; RANKING"
                     android:layout_marginBottom="8dp" />

                <HorizontalScrollView
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:layout_marginBottom="16dp"
                     android:scrollbars="none">

                    <LinearLayout
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                             android:id="@+id/btnFilterRanking"
                             android:layout_height="44dp"
                             android:layout_width="wrap_content"
                             android:layout_marginEnd="8dp"
                             app:backgroundTint="@color/badge_amber_bg"
                             app:cornerRadius="12dp"
                             app:elevation="0dp"
                             android:textColor="@color/badge_amber_icon"
                             android:text="Ranking"
                             android:textStyle="bold"
                             app:icon="@drawable/ic_trophy"
                             app:iconTint="@color/badge_amber_icon"
                             app:iconPadding="6dp" />

                        <com.google.android.material.button.MaterialButton
                             android:id="@+id/btnOfficerList"
                             android:layout_height="44dp"
                             android:layout_width="wrap_content"
                             android:layout_marginEnd="8dp"
                             android:visibility="gone"
                             app:backgroundTint="@color/badge_blue_bg"
                             app:cornerRadius="12dp"
                             app:elevation="0dp"
                             android:textColor="@color/badge_blue_icon"
                             android:text="Officer List"
                             android:textStyle="bold"
                             app:icon="@drawable/ic_officers"
                             app:iconTint="@color/badge_blue_icon"
                             app:iconPadding="6dp" />

                        <com.google.android.material.button.MaterialButton
                             android:id="@+id/btnFilterZone"
                             android:layout_height="44dp"
                             android:layout_width="wrap_content"
                             android:layout_marginEnd="8dp"
                             app:backgroundTint="@color/badge_grey_bg"
                             app:cornerRadius="12dp"
                             app:elevation="0dp"
                             android:textColor="@color/badge_grey_icon"
                             android:text="Zone"
                             android:textStyle="bold"
                             app:icon="@drawable/ic_location"
                             app:iconTint="@color/badge_grey_icon"
                             app:iconPadding="6dp" />

                        <com.google.android.material.button.MaterialButton
                             android:id="@+id/btnFilterTeam"
                             android:layout_height="44dp"
                             android:layout_width="wrap_content"
                             android:layout_marginEnd="4dp"
                             app:backgroundTint="@color/badge_mint_bg"
                             app:cornerRadius="12dp"
                             app:elevation="0dp"
                             android:textColor="@color/badge_mint_icon"
                             android:text="Manager Team"
                             android:textStyle="bold"
                             app:icon="@drawable/ic_supervisor"
                             app:iconTint="@color/badge_mint_icon"
                             app:iconPadding="6dp" />

                    </LinearLayout>

                </HorizontalScrollView>

            </LinearLayout>

            <View
                 android:layout_height="1dp"
                 android:layout_width="match_parent"
                 android:layout_marginBottom="16dp"
                 android:background="@color/divider_color" />

            <!-- Dashboard Feed Header & Sync Refresh -->
            <RelativeLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:layout_marginBottom="12dp">

                <TextView
                     android:id="@+id/tvFilterStatus"
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:layout_centerVertical="true"
                     android:textSize="16sp"
                     android:textColor="@color/text_primary"
                     android:text="Dashboard: 0 cards"
                     android:textStyle="bold" />

                <ImageView
                     android:id="@+id/btnRefresh"
                     android:layout_height="28dp"
                     android:layout_width="28dp"
                     android:src="@drawable/ic_refresh"
                     android:layout_centerVertical="true"
                     app:tint="@color/primary"
                     android:layout_alignParentEnd="true"
                     android:clickable="true"
                     android:focusable="true"
                     android:background="?attr/selectableItemBackgroundBorderless" />

            </RelativeLayout>

            <ProgressBar
                 android:id="@+id/progressBar"
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:visibility="gone"
                 android:layout_gravity="center" />

            <androidx.recyclerview.widget.RecyclerView
                 android:id="@+id/recyclerAdminReport"
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:nestedScrollingEnabled="false" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
