<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="wrap_content"
     android:layout_width="match_parent"
     android:background="@drawable/bg_card_rounded"
     android:padding="22dp"
     android:orientation="vertical">

    <TextView
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:layout_marginBottom="14dp"
         android:textSize="20sp"
         android:textColor="@color/text_primary"
         android:id="@+id/tvExportTitle"
         android:text="Export Performance Report"
         android:textStyle="bold" />

    <!-- Format Selection (Excel vs CSV vs PDF) -->
    <TextView
         android:layout_height="wrap_content"
         android:layout_width="wrap_content"
         android:textColor="@color/text_secondary"
         android:text="Export Format"
         android:textSize="13sp"
         android:textStyle="bold" />

    <RadioGroup
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:layout_marginTop="6dp"
         android:layout_marginBottom="14dp"
         android:orientation="horizontal"
         android:id="@+id/rgExportFormat">

        <RadioButton
             android:layout_height="wrap_content"
             android:layout_width="0dp"
             android:layout_weight="1"
             android:textColor="@color/text_primary"
             android:checked="true"
             android:id="@+id/rbFormatXlsx"
             android:text="Excel (.xlsx)"
             android:textSize="13sp"
             android:textStyle="bold" />

        <RadioButton
             android:layout_height="wrap_content"
             android:layout_width="0dp"
             android:layout_weight="1"
             android:textColor="@color/text_primary"
             android:id="@+id/rbFormatCsv"
             android:text="CSV (.csv)"
             android:textSize="13sp"
             android:textStyle="bold" />

        <RadioButton
             android:layout_height="wrap_content"
             android:layout_width="0dp"
             android:layout_weight="1"
             android:textColor="@color/text_primary"
             android:id="@+id/rbFormatPdf"
             android:text="PDF (.pdf)"
             android:textSize="13sp"
             android:textStyle="bold" />

    </RadioGroup>

    <!-- Month Range -->
    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:weightSum="2"
         android:layout_marginBottom="14dp"
         android:orientation="horizontal">

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="0dp"
             android:layout_marginEnd="8dp"
             android:orientation="vertical"
             android:layout_weight="1">

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textColor="@color/text_secondary"
                 android:text="From Month"
                 android:textSize="13sp"
                 android:textStyle="bold" />

            <Spinner
                 android:layout_height="46dp"
                 android:layout_width="match_parent"
                 android:backgroundTint="@color/primary"
                 android:layout_marginTop="4dp"
                 android:id="@+id/spinnerFromMonth" />

        </LinearLayout>

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="0dp"
             android:orientation="vertical"
             android:layout_marginStart="8dp"
             android:layout_weight="1">

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textColor="@color/text_secondary"
                 android:text="To Month"
                 android:textSize="13sp"
                 android:textStyle="bold" />

            <Spinner
                 android:layout_height="46dp"
                 android:layout_width="match_parent"
                 android:backgroundTint="@color/primary"
                 android:layout_marginTop="4dp"
                 android:id="@+id/spinnerToMonth" />

        </LinearLayout>

    </LinearLayout>

    <!-- Report Type (Summary vs Details) -->
    <TextView
         android:layout_height="wrap_content"
         android:layout_width="wrap_content"
         android:textColor="@color/text_secondary"
         android:text="Report Content"
         android:textSize="13sp"
         android:textStyle="bold" />

    <RadioGroup
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:layout_marginTop="6dp"
         android:layout_marginBottom="20dp"
         android:orientation="horizontal"
         android:id="@+id/rgExportType">

        <RadioButton
             android:layout_height="wrap_content"
             android:layout_width="0dp"
             android:layout_weight="1.2"
             android:textColor="@color/text_primary"
             android:checked="true"
             android:id="@+id/rbFullReport"
             android:text="Full (All)"
             android:textSize="13sp"
             android:textStyle="bold" />

        <RadioButton
             android:layout_height="wrap_content"
             android:layout_width="0dp"
             android:layout_weight="1"
             android:textColor="@color/text_primary"
             android:id="@+id/rbSummary"
             android:text="Summary"
             android:textSize="13sp"
             android:textStyle="bold" />

        <RadioButton
             android:layout_height="wrap_content"
             android:layout_width="0dp"
             android:layout_weight="1"
             android:textColor="@color/text_primary"
             android:id="@+id/rbDetails"
             android:text="Details"
             android:textSize="13sp"
             android:textStyle="bold" />

    </RadioGroup>

    <!-- Download and Share Action Buttons -->
    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:weightSum="2"
         android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
             android:layout_height="50dp"
             android:layout_width="0dp"
             android:layout_weight="1"
             android:layout_marginEnd="6dp"
             app:backgroundTint="@color/primary"
             app:cornerRadius="14dp"
             app:elevation="0dp"
             android:textColor="#FFFFFF"
             android:id="@+id/btnDownloadReport"
             android:text="Download"
             android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
             android:layout_height="50dp"
             android:layout_width="0dp"
             android:layout_weight="1"
             android:layout_marginStart="6dp"
             app:backgroundTint="@color/badge_green_bg"
             app:cornerRadius="14dp"
             app:elevation="0dp"
             android:textColor="@color/badge_green_icon"
             android:id="@+id/btnShareReport"
             android:text="Share"
             android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>

