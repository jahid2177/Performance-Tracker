<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="wrap_content"
     android:layout_width="match_parent"
     android:background="@color/surface"
     android:padding="24dp"
     android:orientation="vertical">

    <TextView
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:layout_marginBottom="18dp"
         android:textSize="20sp"
         android:textColor="@color/text_primary"
         android:id="@+id/tvExportTitle"
         android:text="Export Report"
         android:textStyle="bold" />

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:weightSum="2"
         android:layout_marginBottom="24dp"
         android:orientation="horizontal">

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="0dp"
             android:layout_marginEnd="8dp"
             android:orientation="vertical"
             android:layout_weight="1">

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textColor="@color/text_secondary"
                 android:text="From Month"
                 android:textStyle="bold" />

            <Spinner
                 android:layout_height="48dp"
                 android:layout_width="match_parent"
                 android:backgroundTint="@color/primary"
                 android:layout_marginTop="6dp"
                 android:id="@+id/spinnerFromMonth" />

        </LinearLayout>

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="0dp"
             android:orientation="vertical"
             android:layout_marginStart="8dp"
             android:layout_weight="1">

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textColor="@color/text_secondary"
                 android:text="To Month"
                 android:textStyle="bold" />

            <Spinner
                 android:layout_height="48dp"
                 android:layout_width="match_parent"
                 android:backgroundTint="@color/primary"
                 android:layout_marginTop="6dp"
                 android:id="@+id/spinnerToMonth" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:gravity="bottom"
         android:orientation="horizontal">

        <RadioGroup
             android:layout_height="wrap_content"
             android:layout_width="0dp"
             android:visibility="gone"
             android:orientation="vertical"
             android:layout_weight="1"
             android:id="@+id/rgExportType">

            <RadioButton
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textColor="@color/text_primary"
                 android:checked="true"
                 android:id="@+id/rbSummary"
                 android:text="Summary"
                 android:textStyle="bold" />

            <RadioButton
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textColor="@color/text_primary"
                 android:id="@+id/rbDetails"
                 android:text="Details"
                 android:textStyle="bold" />

        </RadioGroup>

        <com.google.android.material.button.MaterialButton
             android:layout_height="50dp"
             android:layout_width="wrap_content"
             app:backgroundTint="@color/primary"
             app:cornerRadius="14dp"
             app:elevation="0dp"
             android:textColor="#FFFFFF"
             android:id="@+id/btnExportData"
             android:text="Export Report"
             android:textStyle="bold"
             android:layout_gravity="end|bottom" />

    </LinearLayout>

</LinearLayout>
