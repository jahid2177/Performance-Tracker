<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="wrap_content"
     android:layout_width="match_parent"
     android:layout_marginVertical="5dp"
     android:layout_marginHorizontal="16dp"
     app:cardElevation="0dp"
     app:strokeColor="@color/card_stroke"
     app:strokeWidth="1dp"
     app:cardBackgroundColor="@color/surface_card"
     app:cardCornerRadius="18dp">

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:gravity="center_vertical"
         android:padding="16dp"
         android:orientation="horizontal">

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="0dp"
             android:orientation="vertical"
             android:layout_weight="1">

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textSize="17sp"
                 android:textColor="@color/text_primary"
                 android:id="@+id/tvOfficerName"
                 android:text="Employee Name"
                 android:textStyle="bold" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textSize="14sp"
                 android:textColor="@color/text_secondary"
                 android:layout_marginTop="4dp"
                 android:id="@+id/tvOfficerId"
                 android:text="ID: 123456789123"
                 android:textStyle="bold" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textSize="13sp"
                 android:textColor="@color/text_muted"
                 android:layout_marginTop="2dp"
                 android:id="@+id/tvBranchZone"
                 android:text="Branch: branch_name | Zone: zone_name" />

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
             android:layout_height="36dp"
             android:layout_width="36dp"
             android:clickable="true"
             app:cardElevation="0dp"
             app:cardBackgroundColor="@color/badge_red_bg"
             app:cardCornerRadius="18dp"
             android:focusable="true"
             android:id="@+id/btnDeleteOfficer"
             android:foreground="?attr/selectableItemBackground">

            <ImageView
                 android:layout_height="18dp"
                 android:layout_width="18dp"
                 android:layout_gravity="center"
                 android:src="@android:drawable/ic_menu_delete"
                 app:tint="@color/badge_red_icon" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
