<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="wrap_content"
     android:layout_width="match_parent"
     android:layout_marginVertical="5dp"
     app:strokeColor="@color/card_stroke"
     android:layout_marginHorizontal="16dp"
     app:cardElevation="0dp"
     app:strokeWidth="1dp"
     app:cardBackgroundColor="@color/surface_card"
     app:cardCornerRadius="18dp">

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:gravity="center_vertical"
         android:padding="14dp"
         android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
             android:layout_height="38dp"
             android:layout_width="38dp"
             app:cardElevation="0dp"
             app:cardBackgroundColor="@color/badge_amber_bg"
             app:cardCornerRadius="12dp"
             android:id="@+id/cardRankBadge">

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textSize="15sp"
                 android:textColor="@color/badge_amber_icon"
                 android:id="@+id/tvRankNumber"
                 android:layout_gravity="center"
                 android:text="1"
                 android:textStyle="bold" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="0dp"
             android:textSize="16sp"
             android:textColor="@color/text_primary"
             android:layout_marginStart="14dp"
             android:layout_weight="1"
             android:id="@+id/tvRankName"
             android:text="Employee Name"
             android:textStyle="bold" />

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:textSize="15sp"
             android:textColor="@color/primary"
             android:id="@+id/tvRankScore"
             android:text="15 cards"
             android:textStyle="bold" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
