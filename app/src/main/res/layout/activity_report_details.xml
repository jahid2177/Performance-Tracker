<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:background="@color/background"
     android:orientation="vertical">

    <!-- Header matching screenshot aesthetic -->
    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:background="@color/background"
         android:gravity="center_vertical"
         android:paddingHorizontal="20dp"
         android:paddingTop="20dp"
         android:paddingBottom="12dp">

        <com.google.android.material.card.MaterialCardView
             android:layout_height="40dp"
             android:layout_width="40dp"
             android:layout_marginEnd="14dp"
             app:cardCornerRadius="20dp"
             app:cardElevation="0dp"
             app:strokeWidth="1dp"
             app:strokeColor="@color/card_stroke"
             app:cardBackgroundColor="@color/surface"
             android:clickable="true"
             android:focusable="true">

            <ImageView
                 android:layout_height="20dp"
                 android:layout_width="20dp"
                 android:layout_gravity="center"
                 android:src="@drawable/ic_chevron_right"
                 android:rotation="180"
                 app:tint="@color/text_primary"
                 android:id="@+id/btnBack" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:textSize="22sp"
             android:textColor="@color/text_primary"
             android:text="Report Details"
             android:textStyle="bold" />

    </LinearLayout>

    <!-- Detail Info Card -->
    <com.google.android.material.card.MaterialCardView
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:layout_marginHorizontal="16dp"
         android:layout_marginVertical="8dp"
         app:cardElevation="0dp"
         app:strokeColor="@color/card_stroke"
         app:strokeWidth="1dp"
         app:cardBackgroundColor="@color/surface_card"
         app:cardCornerRadius="18dp">

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:padding="16dp"
             android:orientation="vertical">

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textSize="18sp"
                 android:textColor="@color/text_primary"
                 android:id="@+id/tvDetailName"
                 android:textStyle="bold" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:background="@drawable/bg_badge_mint"
                 android:paddingVertical="4dp"
                 android:paddingHorizontal="10dp"
                 android:textSize="13sp"
                 android:textColor="@color/badge_mint_icon"
                 android:layout_marginTop="6dp"
                 android:id="@+id/tvDetailMonth"
                 android:textStyle="bold" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textSize="14sp"
                 android:textColor="@color/text_muted"
                 android:layout_marginTop="6dp"
                 android:id="@+id/tvDetailBranch" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Horizontally Scrollable Table Container so text NEVER wraps -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:fillViewport="true"
        android:scrollbars="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="560dp"
            android:orientation="vertical">

            <!-- Table Header Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/primary"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="12dp"
                        android:text="Sl"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="210dp"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:padding="12dp"
                        android:text="Applicant Name"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:singleLine="true" />

                    <TextView
                        android:layout_width="165dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="12dp"
                        android:text="A/C No"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:singleLine="true" />

                    <TextView
                        android:layout_width="135dp"
                        android:layout_height="wrap_content"
                        android:gravity="center|end"
                        android:padding="12dp"
                        android:text="Limit"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:singleLine="true" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Table Content List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerTable"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/surface_card" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- Total Summary Card -->
    <com.google.android.material.card.MaterialCardView
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:layout_marginBottom="16dp"
         android:layout_marginTop="8dp"
         android:layout_marginHorizontal="16dp"
         app:cardElevation="0dp"
         app:strokeColor="@color/card_stroke"
         app:strokeWidth="1dp"
         app:cardCornerRadius="16dp"
         app:cardBackgroundColor="@color/badge_amber_bg">

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:padding="14dp"
             android:orientation="horizontal">

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="0dp"
                 android:textSize="14sp"
                 android:textColor="@color/badge_amber_icon"
                 android:layout_weight="1"
                 android:text="TOTAL RECORDS &amp; LIMIT:"
                 android:textStyle="bold" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textSize="16sp"
                 android:textColor="@color/badge_amber_icon"
                 android:id="@+id/tvTotalLimit"
                 android:textStyle="bold" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
