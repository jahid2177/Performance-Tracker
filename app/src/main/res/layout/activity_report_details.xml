<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:background="@color/background"
     android:orientation="vertical">

    <!-- Header matching screenshot aesthetic -->
    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:background="@color/background"
         android:gravity="center_vertical"
         android:paddingHorizontal="20dp"
         android:paddingTop="20dp"
         android:paddingBottom="12dp">

        <com.google.android.material.card.MaterialCardView
             android:layout_height="40dp"
             android:layout_width="40dp"
             android:layout_marginEnd="14dp"
             app:cardCornerRadius="20dp"
             app:cardElevation="0dp"
             app:strokeWidth="1dp"
             app:strokeColor="@color/card_stroke"
             app:cardBackgroundColor="@color/surface"
             android:clickable="true"
             android:focusable="true">

            <ImageView
                 android:layout_height="20dp"
                 android:layout_width="20dp"
                 android:layout_gravity="center"
                 android:src="@drawable/ic_chevron_right"
                 android:rotation="180"
                 app:tint="@color/text_primary"
                 android:id="@+id/btnBack" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:textSize="22sp"
             android:textColor="@color/text_primary"
             android:text="Report Details"
             android:textStyle="bold" />

    </LinearLayout>

    <!-- Detail Info Card -->
    <com.google.android.material.card.MaterialCardView
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:layout_marginHorizontal="16dp"
         android:layout_marginVertical="8dp"
         app:cardElevation="0dp"
         app:strokeColor="@color/card_stroke"
         app:strokeWidth="1dp"
         app:cardBackgroundColor="@color/surface_card"
         app:cardCornerRadius="18dp">

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:padding="16dp"
             android:orientation="vertical">

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textSize="18sp"
                 android:textColor="@color/text_primary"
                 android:id="@+id/tvDetailName"
                 android:textStyle="bold" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:background="@drawable/bg_badge_mint"
                 android:paddingVertical="4dp"
                 android:paddingHorizontal="10dp"
                 android:textSize="13sp"
                 android:textColor="@color/badge_mint_icon"
                 android:layout_marginTop="6dp"
                 android:id="@+id/tvDetailMonth"
                 android:textStyle="bold" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textSize="14sp"
                 android:textColor="@color/text_muted"
                 android:layout_marginTop="6dp"
                 android:id="@+id/tvDetailBranch" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Table Header Card -->
    <com.google.android.material.card.MaterialCardView
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:layout_marginHorizontal="16dp"
         android:layout_marginTop="8dp"
         app:cardElevation="0dp"
         app:cardBackgroundColor="@color/primary"
         app:cardCornerRadius="14dp">

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:weightSum="10"
             android:orientation="horizontal">

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="0dp"
                 android:gravity="center"
                 android:padding="12dp"
                 android:textColor="#FFFFFF"
                 android:layout_weight="1.5"
                 android:text="Sl"
                 android:textStyle="bold" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="0dp"
                 android:padding="12dp"
                 android:textColor="#FFFFFF"
                 android:layout_weight="3.5"
                 android:text="Applicant Name"
                 android:textStyle="bold" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="0dp"
                 android:gravity="center"
                 android:padding="12dp"
                 android:textColor="#FFFFFF"
                 android:layout_weight="3"
                 android:text="A/C No"
                 android:textStyle="bold" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="0dp"
                 android:gravity="end"
                 android:padding="12dp"
                 android:textColor="#FFFFFF"
                 android:layout_weight="2"
                 android:text="Limit"
                 android:textStyle="bold" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <androidx.recyclerview.widget.RecyclerView
         android:layout_height="0dp"
         android:layout_width="match_parent"
         android:background="@color/surface_card"
         android:layout_marginHorizontal="16dp"
         android:layout_weight="1"
         android:id="@+id/recyclerTable" />

    <!-- Total Summary Card -->
    <com.google.android.material.card.MaterialCardView
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:layout_marginBottom="16dp"
         android:layout_marginTop="8dp"
         android:layout_marginHorizontal="16dp"
         app:cardElevation="0dp"
         app:strokeColor="@color/card_stroke"
         app:strokeWidth="1dp"
         app:cardCornerRadius="16dp"
         app:cardBackgroundColor="@color/badge_amber_bg">

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:padding="14dp"
             android:orientation="horizontal">

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="0dp"
                 android:textSize="14sp"
                 android:textColor="@color/badge_amber_icon"
                 android:layout_weight="1"
                 android:text="TOTAL RECORDS &amp; LIMIT:"
                 android:textStyle="bold" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textSize="16sp"
                 android:textColor="@color/badge_amber_icon"
                 android:id="@+id/tvTotalLimit"
                 android:textStyle="bold" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
