<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:background="@color/background"
     android:orientation="vertical">

    <!-- Top App Bar in clean screenshot style -->
    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:background="@color/background"
         android:gravity="center_vertical"
         android:paddingHorizontal="20dp"
         android:paddingTop="20dp"
         android:paddingBottom="12dp">

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="0dp"
             android:textSize="26sp"
             android:textColor="@color/text_primary"
             android:layout_weight="1"
             android:id="@+id/tvPageTitle"
             android:text="Dashboard"
             android:textStyle="bold" />

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <com.google.android.material.card.MaterialCardView
                 android:layout_height="40dp"
                 android:layout_width="40dp"
                 app:cardCornerRadius="20dp"
                 app:cardElevation="0dp"
                 app:strokeWidth="1dp"
                 app:strokeColor="@color/card_stroke"
                 app:cardBackgroundColor="@color/surface"
                 android:clickable="true"
                 android:focusable="true"
                 android:id="@+id/btnUserSettings">

                <ImageView
                     android:layout_height="22dp"
                     android:layout_width="22dp"
                     android:layout_gravity="center"
                     android:src="@drawable/ic_settings"
                     app:tint="@color/text_primary" />

            </com.google.android.material.card.MaterialCardView>

            <View
                android:id="@+id/viewUserSettingsRedDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_badge_red_dot"
                android:visibility="gone" />
        </FrameLayout>

    </LinearLayout>

    <ScrollView
         android:layout_height="match_parent"
         android:layout_width="match_parent"
         android:fillViewport="true">

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:orientation="vertical">

            <!-- Main Options styled exactly like screenshot -->
            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:visibility="visible"
                 android:paddingHorizontal="16dp"
                 android:paddingBottom="20dp"
                 android:orientation="vertical"
                 android:id="@+id/mainOptionsLayout">

                <!-- Section: ACTIONS -->
                <TextView
                     style="@style/SectionHeader"
                     android:text="ACTIONS" />

                <!-- Card Group 1 -->
                <com.google.android.material.card.MaterialCardView
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     app:cardElevation="0dp"
                     app:strokeColor="@color/card_stroke"
                     app:strokeWidth="1dp"
                     app:cardBackgroundColor="@color/surface_card"
                     app:cardCornerRadius="18dp">

                    <LinearLayout
                         android:layout_height="wrap_content"
                         android:layout_width="match_parent"
                         android:orientation="vertical">

                        <!-- Option: New Submission -->
                        <LinearLayout
                             android:layout_height="wrap_content"
                             android:layout_width="match_parent"
                             android:clickable="true"
                             android:focusable="true"
                             android:background="?attr/selectableItemBackground"
                             android:padding="16dp"
                             android:gravity="center_vertical"
                             android:orientation="horizontal"
                             android:id="@+id/cardSubmission">

                            <!-- Mint Green Badge -->
                            <FrameLayout
                                 android:layout_height="44dp"
                                 android:layout_width="44dp"
                                 android:background="@drawable/bg_badge_green">

                                <ImageView
                                     android:layout_height="22dp"
                                     android:layout_width="22dp"
                                     android:layout_gravity="center"
                                     android:src="@drawable/ic_submission"
                                     app:tint="@color/badge_green_icon" />

                            </FrameLayout>

                            <LinearLayout
                                 android:layout_height="wrap_content"
                                 android:layout_width="0dp"
                                 android:layout_marginStart="14dp"
                                 android:layout_weight="1"
                                 android:orientation="vertical">

                                <TextView
                                     android:layout_height="wrap_content"
                                     android:layout_width="wrap_content"
                                     android:textSize="16sp"
                                     android:textColor="@color/text_primary"
                                     android:text="New Submission"
                                     android:textStyle="bold" />

                                <TextView
                                     android:layout_height="wrap_content"
                                     android:layout_width="wrap_content"
                                     android:textSize="13sp"
                                     android:layout_marginTop="2dp"
                                     android:textColor="@color/text_secondary"
                                     android:text="Submit monthly performance report" />

                            </LinearLayout>

                            <ImageView
                                 android:layout_height="20dp"
                                 android:layout_width="20dp"
                                 android:src="@drawable/ic_chevron_right"
                                 app:tint="@color/chevron_color" />

                        </LinearLayout>

                        <!-- Subtle Divider -->
                        <View
                             android:layout_height="1dp"
                             android:layout_width="match_parent"
                             android:layout_marginStart="72dp"
                             android:background="@color/divider_color" />

                        <!-- Option: Officer List -->
                        <LinearLayout
                             android:layout_height="wrap_content"
                             android:layout_width="match_parent"
                             android:clickable="true"
                             android:focusable="true"
                             android:background="?attr/selectableItemBackground"
                             android:padding="16dp"
                             android:gravity="center_vertical"
                             android:orientation="horizontal"
                             android:id="@+id/cardOfficerList">

                            <!-- Soft Blue Badge -->
                            <FrameLayout
                                 android:layout_height="44dp"
                                 android:layout_width="44dp"
                                 android:background="@drawable/bg_badge_blue">

                                <ImageView
                                     android:layout_height="22dp"
                                     android:layout_width="22dp"
                                     android:layout_gravity="center"
                                     android:src="@drawable/ic_officers"
                                     app:tint="@color/badge_blue_icon" />

                            </FrameLayout>

                            <LinearLayout
                                 android:layout_height="wrap_content"
                                 android:layout_width="0dp"
                                 android:layout_marginStart="14dp"
                                 android:layout_weight="1"
                                 android:orientation="vertical">

                                <TextView
                                     android:layout_height="wrap_content"
                                     android:layout_width="wrap_content"
                                     android:textSize="16sp"
                                     android:textColor="@color/text_primary"
                                     android:text="Officer List"
                                     android:textStyle="bold" />

                                <TextView
                                     android:layout_height="wrap_content"
                                     android:layout_width="wrap_content"
                                     android:textSize="13sp"
                                     android:layout_marginTop="2dp"
                                     android:textColor="@color/text_secondary"
                                     android:text="View approved team officers" />

                            </LinearLayout>

                            <ImageView
                                 android:layout_height="20dp"
                                 android:layout_width="20dp"
                                 android:src="@drawable/ic_chevron_right"
                                 app:tint="@color/chevron_color" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Section: TARGET & PERFORMANCE -->
                <TextView
                     style="@style/SectionHeader"
                     android:layout_marginTop="24dp"
                     android:text="TARGET &amp; PERFORMANCE" />

                <!-- Card Group: Target & Achievement -->
                <com.google.android.material.card.MaterialCardView
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     app:cardElevation="0dp"
                     app:strokeColor="@color/card_stroke"
                     app:strokeWidth="1dp"
                     app:cardBackgroundColor="@color/surface_card"
                     app:cardCornerRadius="18dp"
                     android:clickable="true"
                     android:focusable="true"
                     android:foreground="?attr/selectableItemBackground"
                     android:id="@+id/cardUserTargetAchievement">

                    <LinearLayout
                         android:layout_height="wrap_content"
                         android:layout_width="match_parent"
                         android:orientation="vertical"
                         android:padding="16dp">

                        <LinearLayout
                             android:layout_height="wrap_content"
                             android:layout_width="match_parent"
                             android:gravity="center_vertical"
                             android:orientation="horizontal">

                            <!-- Mint Target Badge -->
                            <FrameLayout
                                 android:layout_height="44dp"
                                 android:layout_width="44dp"
                                 android:background="@drawable/bg_badge_mint">

                                <ImageView
                                     android:layout_height="22dp"
                                     android:layout_width="22dp"
                                     android:layout_gravity="center"
                                     android:src="@drawable/ic_target"
                                     app:tint="@color/badge_mint_icon" />

                            </FrameLayout>

                            <LinearLayout
                                 android:layout_height="wrap_content"
                                 android:layout_width="0dp"
                                 android:layout_marginStart="14dp"
                                 android:layout_weight="1"
                                 android:orientation="vertical">

                                <TextView
                                     android:layout_height="wrap_content"
                                     android:layout_width="wrap_content"
                                     android:textSize="16sp"
                                     android:textColor="@color/text_primary"
                                     android:id="@+id/tvUserTargetMonthTitle"
                                     android:text="Monthly Target"
                                     android:textStyle="bold" />

                                <TextView
                                     android:layout_height="wrap_content"
                                     android:layout_width="wrap_content"
                                     android:textSize="13sp"
                                     android:layout_marginTop="2dp"
                                     android:textColor="@color/text_secondary"
                                     android:id="@+id/tvUserTargetSummary"
                                     android:text="Target: 0 | Achieved: 0 cards" />

                            </LinearLayout>

                            <TextView
                                 android:layout_height="wrap_content"
                                 android:layout_width="wrap_content"
                                 android:textSize="13sp"
                                 android:textStyle="bold"
                                 android:paddingHorizontal="10dp"
                                 android:paddingVertical="4dp"
                                 android:background="@drawable/bg_badge_green"
                                 android:textColor="@color/badge_green_icon"
                                 android:id="@+id/tvUserAchievementPercentBadge"
                                 android:text="0.0%" />

                        </LinearLayout>

                        <!-- Progress indicator -->
                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progressUserTarget"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="8dp"
                            app:trackColor="#E0E0E0"
                            app:indicatorColor="@color/primary"
                            android:progress="0"
                            android:max="100" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="10dp">

                            <TextView
                                android:id="@+id/tvUserTargetMotivation"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary"
                                android:text="Tap to view monthly target breakdown" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="@color/chevron_color" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Section: REPORTS & EVALUATION -->
                <TextView
                     style="@style/SectionHeader"
                     android:layout_marginTop="24dp"
                     android:text="REPORTS &amp; EVALUATION" />

                <!-- Card Group 2 -->
                <com.google.android.material.card.MaterialCardView
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     app:cardElevation="0dp"
                     app:strokeColor="@color/card_stroke"
                     app:strokeWidth="1dp"
                     app:cardBackgroundColor="@color/surface_card"
                     app:cardCornerRadius="18dp">

                    <LinearLayout
                         android:layout_height="wrap_content"
                         android:layout_width="match_parent"
                         android:orientation="vertical">

                        <!-- Option: My Report -->
                        <LinearLayout
                             android:layout_height="wrap_content"
                             android:layout_width="match_parent"
                             android:clickable="true"
                             android:focusable="true"
                             android:background="?attr/selectableItemBackground"
                             android:padding="16dp"
                             android:gravity="center_vertical"
                             android:orientation="horizontal"
                             android:id="@+id/cardMyReport">

                            <!-- Mint/Sage Badge -->
                            <FrameLayout
                                 android:layout_height="44dp"
                                 android:layout_width="44dp"
                                 android:background="@drawable/bg_badge_mint">

                                <ImageView
                                     android:layout_height="22dp"
                                     android:layout_width="22dp"
                                     android:layout_gravity="center"
                                     android:src="@drawable/ic_report"
                                     app:tint="@color/badge_mint_icon" />

                            </FrameLayout>

                            <LinearLayout
                                 android:layout_height="wrap_content"
                                 android:layout_width="0dp"
                                 android:layout_marginStart="14dp"
                                 android:layout_weight="1"
                                 android:orientation="vertical">

                                <TextView
                                     android:layout_height="wrap_content"
                                     android:layout_width="wrap_content"
                                     android:textSize="16sp"
                                     android:textColor="@color/text_primary"
                                     android:text="My Report"
                                     android:textStyle="bold" />

                                <TextView
                                     android:layout_height="wrap_content"
                                     android:layout_width="wrap_content"
                                     android:textSize="13sp"
                                     android:layout_marginTop="2dp"
                                     android:textColor="@color/text_secondary"
                                     android:text="Review your submitted reports" />

                            </LinearLayout>

                            <ImageView
                                 android:layout_height="20dp"
                                 android:layout_width="20dp"
                                 android:src="@drawable/ic_chevron_right"
                                 app:tint="@color/chevron_color" />

                        </LinearLayout>

                        <!-- Subtle Divider -->
                        <View
                             android:layout_height="1dp"
                             android:layout_width="match_parent"
                             android:layout_marginStart="72dp"
                             android:background="@color/divider_color" />

                        <!-- Option: Ranking -->
                        <LinearLayout
                             android:layout_height="wrap_content"
                             android:layout_width="match_parent"
                             android:clickable="true"
                             android:focusable="true"
                             android:background="?attr/selectableItemBackground"
                             android:padding="16dp"
                             android:gravity="center_vertical"
                             android:orientation="horizontal"
                             android:id="@+id/cardRanking">

                            <!-- Amber/Peach Badge -->
                            <FrameLayout
                                 android:layout_height="44dp"
                                 android:layout_width="44dp"
                                 android:background="@drawable/bg_badge_amber">

                                <ImageView
                                     android:layout_height="22dp"
                                     android:layout_width="22dp"
                                     android:layout_gravity="center"
                                     android:src="@drawable/ic_ranking"
                                     app:tint="@color/badge_amber_icon" />

                            </FrameLayout>

                            <LinearLayout
                                 android:layout_height="wrap_content"
                                 android:layout_width="0dp"
                                 android:layout_marginStart="14dp"
                                 android:layout_weight="1"
                                 android:orientation="vertical">

                                <TextView
                                     android:layout_height="wrap_content"
                                     android:layout_width="wrap_content"
                                     android:textSize="16sp"
                                     android:textColor="@color/text_primary"
                                     android:text="Ranking"
                                     android:textStyle="bold" />

                                <TextView
                                     android:layout_height="wrap_content"
                                     android:layout_width="wrap_content"
                                     android:textSize="13sp"
                                     android:layout_marginTop="2dp"
                                     android:textColor="@color/text_secondary"
                                     android:text="Top performers leaderboard" />

                            </LinearLayout>

                            <ImageView
                                 android:layout_height="20dp"
                                 android:layout_width="20dp"
                                 android:src="@drawable/ic_chevron_right"
                                 app:tint="@color/chevron_color" />

                        </LinearLayout>

                        <View style="@style/Divider" />

                        <!-- Option: Settings -->
                        <LinearLayout
                             android:layout_height="wrap_content"
                             android:layout_width="match_parent"
                             android:background="?attr/selectableItemBackground"
                             android:clickable="true"
                             android:focusable="true"
                             android:gravity="center_vertical"
                             android:padding="16dp"
                             android:orientation="horizontal"
                             android:id="@+id/cardUserSettings">

                            <com.google.android.material.card.MaterialCardView
                                 android:layout_height="44dp"
                                 android:layout_width="44dp"
                                 app:cardCornerRadius="12dp"
                                 app:cardElevation="0dp"
                                 app:cardBackgroundColor="@color/badge_grey_bg">

                                <ImageView
                                     android:layout_height="22dp"
                                     android:layout_width="22dp"
                                     android:layout_gravity="center"
                                     android:src="@drawable/ic_settings"
                                     app:tint="@color/badge_grey_icon" />

                            </com.google.android.material.card.MaterialCardView>

                            <LinearLayout
                                 android:layout_height="wrap_content"
                                 android:layout_width="0dp"
                                 android:layout_marginStart="14dp"
                                 android:layout_weight="1"
                                 android:orientation="vertical">

                                <TextView
                                     android:layout_height="wrap_content"
                                     android:layout_width="wrap_content"
                                     android:textSize="16sp"
                                     android:textColor="@color/text_primary"
                                     android:text="Settings"
                                     android:textStyle="bold" />

                                <TextView
                                     android:layout_height="wrap_content"
                                     android:layout_width="wrap_content"
                                     android:textSize="13sp"
                                     android:layout_marginTop="2dp"
                                     android:textColor="@color/text_secondary"
                                     android:text="Profile, security, app info &amp; exit" />

                            </LinearLayout>

                            <ImageView
                                 android:layout_height="20dp"
                                 android:layout_width="20dp"
                                 android:src="@drawable/ic_chevron_right"
                                 app:tint="@color/chevron_color" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Form Layout (When New Submission is clicked) -->
            <LinearLayout
                 android:layout_height="match_parent"
                 android:layout_width="match_parent"
                 android:visibility="gone"
                 android:padding="16dp"
                 android:orientation="vertical"
                 android:id="@+id/submissionFormLayout">

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:layout_marginBottom="12dp"
                     android:textSize="18sp"
                     android:textColor="@color/text_primary"
                     android:id="@+id/tvEmpName"
                     android:text="Welcome, Md Jahidul Islam"
                     android:textStyle="bold" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="14sp"
                     android:textColor="@color/text_secondary"
                     android:text="Reporting Month:"
                     android:textStyle="bold" />

                <Spinner
                     android:layout_height="50dp"
                     android:layout_width="match_parent"
                     android:background="@drawable/bg_edittext_simple"
                     android:layout_marginTop="6dp"
                     android:id="@+id/spinnerMonth" />

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:orientation="horizontal"
                     android:layout_marginTop="16dp"
                     android:paddingHorizontal="4dp">

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="0dp"
                         android:textSize="14sp"
                         android:textColor="@color/text_primary"
                         android:layout_weight="1"
                         android:text="Name"
                         android:textStyle="bold" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="0dp"
                         android:textSize="14sp"
                         android:textColor="@color/text_primary"
                         android:layout_weight="1"
                         android:text="A/C No"
                         android:textStyle="bold" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="0dp"
                         android:gravity="center_horizontal"
                         android:textSize="14sp"
                         android:textColor="@color/text_primary"
                         android:layout_weight="1"
                         android:text="Limit"
                         android:textStyle="bold" />

                </LinearLayout>

                <ScrollView
                     android:layout_height="0dp"
                     android:layout_width="match_parent"
                     android:layout_marginTop="8dp"
                     android:layout_weight="1">

                    <LinearLayout
                         android:layout_height="wrap_content"
                         android:layout_width="match_parent"
                         android:orientation="vertical"
                         android:id="@+id/rowsContainer" />

                </ScrollView>

                <com.google.android.material.button.MaterialButton
                     android:layout_height="52dp"
                     android:layout_width="match_parent"
                     app:cornerRadius="14dp"
                     app:strokeColor="@color/primary"
                     app:strokeWidth="1.5dp"
                     android:backgroundTint="@color/badge_blue_bg"
                     android:textColor="@color/primary"
                     android:layout_marginTop="10dp"
                     app:icon="@drawable/ic_file_pdf"
                     app:iconTint="@color/primary"
                     app:iconGravity="textStart"
                     android:id="@+id/btnUploadPdf"
                     android:text="Upload PDF File"
                     android:textStyle="bold" />

                <Button
                     android:layout_height="52dp"
                     android:layout_width="match_parent"
                     app:cornerRadius="14dp"
                     android:backgroundTint="@color/primary"
                     android:textColor="@color/white"
                     android:layout_marginTop="8dp"
                     android:id="@+id/btnAddMore"
                     android:text="Add More Row"
                     android:textStyle="bold" />

                <com.google.android.material.checkbox.MaterialCheckBox
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:textColor="@color/text_primary"
                     app:buttonTint="@color/badge_red_icon"
                     android:layout_marginTop="6dp"
                     android:id="@+id/cbZeroApproval"
                     android:text="Zero approval this month"
                     android:textStyle="bold" />

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:weightSum="2"
                     android:orientation="horizontal"
                     android:layout_marginTop="14dp">

                    <Button
                         android:layout_height="52dp"
                         android:layout_width="0dp"
                         android:layout_marginEnd="6dp"
                         app:cornerRadius="14dp"
                         android:backgroundTint="@color/badge_grey_bg"
                         android:textColor="@color/text_primary"
                         android:layout_weight="1"
                         android:id="@+id/btnBackToHome"
                         android:text="Back"
                         android:textStyle="bold" />

                    <Button
                         android:layout_height="52dp"
                         android:layout_width="0dp"
                         app:cornerRadius="14dp"
                         android:backgroundTint="@color/primary"
                         android:textColor="@color/white"
                         android:layout_weight="1"
                         android:id="@+id/btnSubmit"
                         android:text="Submit"
                         android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
